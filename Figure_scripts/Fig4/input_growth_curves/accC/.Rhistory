filter(
as.character(
strain
) ==
selected_guide
)
panel_F_selected_guide <- ggplot(
selected_growth_summary,
aes(
x = time,
y = mean,
color = conditions,
fill = conditions
)
) +
geom_rect(
aes(
xmin = ANALYSIS_TIME_LEFT,
xmax = ANALYSIS_TIME_RIGHT,
ymin = ANALYSIS_OD_LOWER,
ymax = ANALYSIS_OD_UPPER
),
fill = NA,
color = "grey50",
linetype = "dashed",
linewidth = 0.6,
inherit.aes = FALSE
) +
geom_ribbon(
aes(
ymin = low,
ymax = high,
group = conditions
),
alpha = 0.35,
color = NA
) +
geom_line(
aes(
group = conditions
),
linewidth = 1.2
) +
geom_line(
data =
selected_expected_curve,
aes(
x = time,
y =
expected_multiplicative,
linetype =
"Multiplicative expectation"
),
color = "black",
linewidth = 0.95,
inherit.aes = FALSE
) +
scale_colour_manual(
values =
CURVE_COLORS,
breaks =
ORDER_CONDITIONS,
labels =
CONDITION_LABELS
) +
scale_fill_manual(
values =
CURVE_COLORS,
breaks =
ORDER_CONDITIONS,
labels =
CONDITION_LABELS
) +
scale_linetype_manual(
values = c(
"Multiplicative expectation" =
"dashed"
),
name = NULL
) +
coord_cartesian(
xlim = c(
PLOT_TIME_MIN,
PLOT_TIME_MAX
),
ylim = c(
PLOT_OD_MIN,
PLOT_OD_MAX
)
) +
labs(
title = paste0(
pretty_guide_name(
selected_guide
),
": observed and multiplicative expected growth"
),
x = "Time [h]",
y = "Growth [OD 600 nm]",
color = "Condition",
fill = "Condition"
) +
theme_linedraw(
base_size = 9
) +
theme(
axis.text.x = element_text(
angle = 90,
hjust = 1
),
legend.position = "top",
legend.background =
element_blank(),
plot.title = element_text(
face = "bold",
size = 9.5
),
plot.margin = margin(
t = 8,
r = 8,
b = 8,
l = 8
)
)
# ============================================================
# DISPLAY EACH SUBPANEL IN RSTUDIO
# ============================================================
if (
isTRUE(
PRINT_ALL_SUBPANELS_IN_RSTUDIO
)
) {
print(
panel_A_guides
)
print(
panel_B_growth_curves
)
print(
panel_C_maximum_growth_rate
)
print(
panel_D_median_growth_rate
)
print(
panel_E_auc
)
print(
panel_F_selected_guide
)
}
# ============================================================
# COMBINED FIGURE A-F
# ============================================================
figure_design <- "
AAABBBBB
AAABBBBB
CCCCDDDD
EEEEFFFF
"
combined_figure <- panel_A_guides +
panel_B_growth_curves +
panel_C_maximum_growth_rate +
panel_D_median_growth_rate +
panel_E_auc +
panel_F_selected_guide +
plot_layout(
design =
figure_design
) +
plot_annotation(
title =
PLOT_TITLE,
tag_levels = "A",
theme = theme(
plot.title = element_text(
face = "bold",
hjust = 0.5,
size = 14
),
plot.tag = element_text(
face = "bold",
size = 15
)
)
)
if (
isTRUE(
PRINT_COMBINED_FIGURE_IN_RSTUDIO
)
) {
print(
combined_figure
)
}
save_ggplot_all_formats(
plot_object =
combined_figure,
basename =
OUTPUT_BASENAME,
width = 16,
height = 13.5
)
# ============================================================
# EFFECT-SIZE PLOT: OBSERVED METRICS, NOT EFFICACY-CURVE FITS
# ============================================================
effect_plot_data <- metric_statistics %>%
mutate(
guide_label = factor(pretty_guide_name(as.character(strain)),
levels = rev(pretty_guide_name(ORDER_ON_PLOT))),
metric_label = factor(metric,
levels = c("median_growth_rate", "maximum_growth_rate", "auc"),
labels = c("Median OD600 increase (primary)", "Maximum OD600 increase", "Capped AUC"))
)
interaction_effect_plot <- ggplot(effect_plot_data,
aes(x = normalized_interaction_effect, y = guide_label)) +
geom_vline(xintercept = 0, colour = "grey40", linewidth = 0.4) +
geom_vline(xintercept = NORMALIZED_INTERACTION_CUTOFF,
colour = "#B2182B", linetype = "dashed", linewidth = 0.5) +
geom_segment(aes(x = normalized_ci_lower, xend = normalized_ci_upper,
yend = guide_label), linewidth = 0.6, na.rm = TRUE) +
geom_point(aes(colour = passes_effect_size), size = 2.2, na.rm = TRUE) +
scale_colour_manual(values = c("FALSE" = "grey35", "TRUE" = "#B2182B"),
labels = c("FALSE" = "Above effect threshold", "TRUE" = "Meets effect threshold"),
name = NULL) +
facet_wrap(~metric_label, nrow = 1, scales = "free_x") +
labs(x = "Normalized observed - expected effect", y = NULL,
title = "Interaction effect sizes and bootstrap intervals",
caption = paste0("Lines: ", 100 * BOOTSTRAP_CONFIDENCE,
"% pointwise bootstrap intervals. Negative values indicate additional inhibition.\n",
"Dashed line: selected effect-size threshold. Intervals do not account for manual window selection.")) +
theme_bw() +
theme(legend.position = "bottom", plot.title = element_text(face = "bold"),
plot.caption = element_text(hjust = 0))
if (isTRUE(PRINT_ALL_SUBPANELS_IN_RSTUDIO)) print(interaction_effect_plot)
save_ggplot_all_formats(interaction_effect_plot,
paste0(OUTPUT_BASENAME, "_interaction_effects"), width = 11, height = 4.8)
# ============================================================
# EXCEL EXPORT
# ============================================================
guide_export <- guide_annotation %>%
transmute(
guide =
as.character(
guide
),
guide_display,
sequence,
mismatch_position,
full_match_base,
mismatch_base,
mismatch_label,
predicted_efficacy =
pred_efficacy,
is_full_match
)
metric_summary_export <- metric_summary %>%
left_join(
metric_statistics,
by = c(
"metric",
"strain"
)
) %>%
arrange(
metric,
strain,
conditions
)
write_xlsx(
list(
analysis_methods = as.data.frame(methods_export),
window_check = as.data.frame(window_check_statistics),
guide_annotation =
as.data.frame(
guide_export
),
blank_correction =
as.data.frame(
blank_curve
),
growth_curve_summary =
as.data.frame(
growth_summary
),
selected_guide_expected_curve =
as.data.frame(
selected_expected_curve
),
per_well_metrics =
as.data.frame(
curve_metrics_wide
),
metric_summary_and_statistics =
as.data.frame(
metric_summary_export
),
multiplicative_statistics =
as.data.frame(
metric_statistics
),
efficacy_model_predictions =
as.data.frame(
metric_model_predictions
),
fitted_multiplicative_curves =
as.data.frame(
metric_multiplicative_curves
)
),
path = file.path(
OUTPUT_DIR,
paste0(
OUTPUT_BASENAME,
"_data_and_statistics.xlsx"
)
),
format_headers = TRUE
)
# ============================================================
# GLOBAL OBJECTS AND STATUS MESSAGE
# ============================================================
assign(
"accC_initial_raw_plate_qc",
initial_raw_plate_qc_plot,
envir = .GlobalEnv
)
assign(
"accC_panel_A_guides",
panel_A_guides,
envir = .GlobalEnv
)
assign(
"accC_panel_B_growth_curves",
panel_B_growth_curves,
envir = .GlobalEnv
)
assign(
"accC_panel_C_maximum_growth_rate",
panel_C_maximum_growth_rate,
envir = .GlobalEnv
)
assign(
"accC_panel_D_median_growth_rate",
panel_D_median_growth_rate,
envir = .GlobalEnv
)
assign(
"accC_panel_E_auc",
panel_E_auc,
envir = .GlobalEnv
)
assign(
"accC_panel_F_selected_guide",
panel_F_selected_guide,
envir = .GlobalEnv
)
assign(
"accC_combined_figure_A_to_F",
combined_figure,
envir = .GlobalEnv
)
message(
"Completed accC growth analysis.",
"\nInitial raw-plate QC plot printed first: ",
PRINT_INITIAL_PLATE_QC_IN_RSTUDIO,
".",
"\nPanels generated: A-F plus the effect-size plot.",
"\nAll six subpanels were printed separately in RStudio: ",
PRINT_ALL_SUBPANELS_IN_RSTUDIO,
".",
"\nPanel B uses the original growth-curve style.",
"\nPanels C-E show each metric versus predicted efficacy.",
"\nPanel F guide: ",
pretty_guide_name(
selected_guide
),
".",
"\nGrowth-rate window: ",
ANALYSIS_TIME_LEFT,
"-",
ANALYSIS_TIME_RIGHT,
" h and OD ",
ANALYSIS_OD_LOWER,
"-",
ANALYSIS_OD_UPPER,
".",
"\nAUC window: ",
AUC_TIME_LEFT,
"-",
AUC_TIME_RIGHT,
" h, with OD capped at ",
AUC_OD_CAP,
".",
"\nInteraction estimates: normalized observed - expected effect; ",
100 * BOOTSTRAP_CONFIDENCE,
"% pointwise bootstrap intervals using all four conditions.",
"\nOperational effect-size threshold: ",
NORMALIZED_INTERACTION_CUTOFF,
". No p-values or significance stars are produced.",
"\nReplicate assumption: independent biological replicates, one per well.",
"\nWindow shifts checked (h): ",
paste(window_shifts, collapse = ", "),
". Manual window selection remains exploratory.",
"\nFigure formats: PNG and PDF only.",
"\nOutput directory:\n  ",
OUTPUT_DIR
)
# ============================================================
# SAVE INDIVIDUAL PLOTS
# PNG AND PDF
# ============================================================
INDIVIDUAL_PLOT_DIR <- file.path(
OUTPUT_DIR,
"individual_panels"
)
dir.create(
INDIVIDUAL_PLOT_DIR,
recursive = TRUE,
showWarnings = FALSE
)
save_individual_plot <- function(
plot_object,
filename,
width,
height,
dpi = 300
) {
ggplot2::ggsave(
filename = file.path(
INDIVIDUAL_PLOT_DIR,
paste0(
filename,
".png"
)
),
plot = plot_object,
width = width,
height = height,
units = "in",
dpi = dpi,
bg = "white"
)
ggplot2::ggsave(
filename = file.path(
INDIVIDUAL_PLOT_DIR,
paste0(
filename,
".pdf"
)
),
plot = plot_object,
width = width,
height = height,
units = "in",
device = grDevices::cairo_pdf,
bg = "white"
)
}
# ------------------------------------------------------------
# Define the size of each exported panel in inches
# ------------------------------------------------------------
save_individual_plot(
plot_object = initial_raw_plate_qc_plot,
filename = "QC_raw_plate_overview",
width = 14,
height = 9
)
save_individual_plot(
plot_object = panel_A_guides,
filename = "Panel_A_guide_sequences",
width = 6,
height = 4
)
save_individual_plot(
plot_object = panel_B_growth_curves,
filename = "Panel_B_growth_curves",
width = 7,
height = 3.7
)
save_individual_plot(
plot_object = panel_C_maximum_growth_rate,
filename = "Panel_C_maximum_growth_rate",
width = 4.5,
height = 2.25
)
save_individual_plot(
plot_object = panel_D_median_growth_rate,
filename = "Panel_D_median_growth_rate",
width = 2.5,
height = 2.25
)
save_individual_plot(
plot_object = panel_E_auc,
filename = "Panel_E_AUC",
width = 2.5,
height = 2.25
)
save_individual_plot(
plot_object = panel_F_selected_guide,
filename = paste0(
"Panel_F_",
selected_guide,
"_growth_curve"
),
width = 7,
height = 5
)
message(
"Individual plots saved to:\n  ",
INDIVIDUAL_PLOT_DIR
)
